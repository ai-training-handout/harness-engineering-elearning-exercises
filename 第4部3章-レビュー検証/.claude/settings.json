{
  "outputStyle": "review-report",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(uv run pytest:*)",
      "Bash(python3 cost/measure_tokens.py:*)",
      "Bash(python cost/measure_tokens.py:*)",
      "Bash(uv run python cost/measure_tokens.py:*)",
      "Edit(./reports/**)"
    ],
    "deny": [
      "Edit(./sample-pr/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(rm:*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(sed -i:*)",
      "Bash(tee:*)"
    ],
    "ask": [
      "Edit(./cost/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/validate_target.sh\""
          }
        ]
      }
    ]
  }
}
