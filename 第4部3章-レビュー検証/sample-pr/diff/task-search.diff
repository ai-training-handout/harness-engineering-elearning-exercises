+"""HTML と JSON の同一絞り込み・HTMX 断片・UI smoke（spec-search.md 正しさ7 / 実装制約）。"""
+
+from __future__ import annotations
+
+
+def _create(client, **overrides):
+    payload = {"title": "t"}
+    payload.update(overrides)
+    r = client.post("/api/tasks", json=payload)
+    assert r.status_code == 201, r.text
+    return r.json()
+
+
+def test_html_search_form_present(client_member1):
+    r = client_member1.get("/tasks")
+    assert r.status_code == 200
+    assert 'name="q"' in r.text
+    assert 'name="status"' in r.text
+
+
+def test_html_zero_hits_message(client_member1):
+    r = client_member1.get("/tasks", params={"q": "no_such_task_zzz"})
+    assert r.status_code == 200
+    assert "タスクがありません" in r.text
+
+
+def test_html_and_json_same_filter(client_member1):
+    _create(client_member1, title="alpha one", status="todo")
+    _create(client_member1, title="alpha two", status="done")
+    _create(client_member1, title="beta", status="todo")
+
+    params = {"q": "alpha", "status": "todo"}
+    r_json = client_member1.get("/api/tasks", params=params)
+    r_html = client_member1.get("/tasks", params=params)
+    assert r_json.status_code == 200
+    assert r_html.status_code == 200
+    body = r_json.json()
+    # JSON 側は 1 件（"alpha one"）
+    assert body["total"] == 1
+    ids = [i["id"] for i in body["items"]]
+    # HTML 側でも同じタスクだけが表示される
+    for i in ids:
+        assert f'data-task-id="{i}"' in r_html.text or f'"/tasks/{i}"' in r_html.text
+    # HTML 側の総件数表示に 1 が入る
+    assert ">1<" in r_html.text or "1</span>" in r_html.text
+
+
+def test_html_pager_preserves_query(client_member1):
+    # per_page=1 で 2 件作れば 2 ページになる
+    _create(client_member1, title="alpha 1")
+    _create(client_member1, title="alpha 2")
+    r = client_member1.get("/tasks", params={"q": "alpha", "per_page": 1})
+    assert r.status_code == 200
+    # 次ページリンクに q=alpha が保持されていること
+    assert "q=alpha" in r.text
+    assert "page=2" in r.text
+
+
+def test_html_pager_preserves_multi_status(client_member1):
+    # status 複数指定でも、ページャリンクに両方の status が保持されること
+    _create(client_member1, title="a", status="todo")
+    _create(client_member1, title="b", status="doing")
+    _create(client_member1, title="c", status="todo")
+    r = client_member1.get(
+        "/tasks",
+        params=[("status", "todo"), ("status", "doing"), ("per_page", "1")],
+    )
+    assert r.status_code == 200
+    assert "status=todo" in r.text
+    assert "status=doing" in r.text
+    assert "page=2" in r.text
+
+
+def test_html_htmx_returns_fragment(client_member1):
+    r = client_member1.get("/tasks", headers={"HX-Request": "true"})
+    assert r.status_code == 200
+    # フルページの外枠は含まない
+    assert "<html" not in r.text.lower()
+    assert "<body" not in r.text.lower()
+    # 断片の目印はある
+    assert "task-list-region" in r.text
