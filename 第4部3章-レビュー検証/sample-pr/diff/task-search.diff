+{# 検索結果の一覧領域。フルページと HTMX 応答の両方で使用。 #}
+<div id="task-list-region">
+  <p class="total">総件数: <span data-total>{{ total }}</span></p>
+  {% if tasks %}
+    <ul id="task-list">
+      {% for task in tasks %}
+        {% include "_task_row.html" %}
+      {% endfor %}
+    </ul>
+  {% else %}
+    <ul id="task-list"></ul>
+    <p>タスクがありません</p>
+  {% endif %}
+
+  {% set base_qs = [] %}
+  {% for k, v in query_params %}
+    {% if k != "page" %}
+      {% set _ = base_qs.append(k ~ "=" ~ v) %}
+    {% endif %}
+  {% endfor %}
+  {% set base = base_qs | join("&") %}
+
+  <nav class="pager">
+    {% if page > 1 %}
+      {% set prev_qs = base ~ ("&" if base else "") ~ "page=" ~ (page - 1) %}
+      <a class="pager-prev" hx-get="/tasks?{{ prev_qs }}" hx-target="#task-list-region" hx-push-url="true" href="/tasks?{{ prev_qs }}">前へ</a>
+    {% endif %}
+    <span class="pager-info">{{ page }} / {{ total_pages }}</span>
+    {% if page < total_pages %}
+      {% set next_qs = base ~ ("&" if base else "") ~ "page=" ~ (page + 1) %}
+      <a class="pager-next" hx-get="/tasks?{{ next_qs }}" hx-target="#task-list-region" hx-push-url="true" href="/tasks?{{ next_qs }}">次へ</a>
+    {% endif %}
+  </nav>
+</div>
