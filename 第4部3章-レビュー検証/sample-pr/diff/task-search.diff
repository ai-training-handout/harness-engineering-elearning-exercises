+def _build_search_where(user: dict[str, Any], q: SearchQuery) -> tuple[str, list[Any]]:
+    """検索用 WHERE 句とパラメータを組み立てる。"""
+    clauses: list[str] = ["1=1"]
+    params: list[Any] = []
+
+    if q.q:
+        like = f"%{q.q.lower()}%"
+        clauses.append("(LOWER(title) LIKE ? OR LOWER(description) LIKE ?)")
+        params.extend([like, like])
+
+    if q.status:
+        placeholders = ",".join(["?"] * len(q.status))
+        clauses.append(f"status IN ({placeholders})")
+        params.extend(list(q.status))
+
+    if q.priority is not None:
+        clauses.append("priority = ?")
+        params.append(q.priority)
+
+    if q.tag is not None:
+        clauses.append("EXISTS (SELECT 1 FROM task_tags WHERE task_id = tasks.id AND tag = ?)")
+        params.append(q.tag)
+
+    if q.assignee_id is not None:
+        clauses.append("assignee_id = ?")
+        params.append(q.assignee_id)
+
+    if q.due_from is not None:
+        clauses.append("due_date IS NOT NULL AND due_date >= ?")
+        params.append(q.due_from)
+
+    if q.due_to is not None:
+        clauses.append("due_date IS NOT NULL AND due_date <= ?")
+        params.append(q.due_to)
+
+    if q.overdue == "true":
+        today = date.today().isoformat()
+        clauses.append("due_date IS NOT NULL AND due_date < ? AND status != 'done'")
+        params.append(today)
+
+    # 絞り込み条件が無い場合は従来の一覧と同じ権限範囲に限定する
+    if len(clauses) == 1 and user["role"] != "admin":
+        clauses.append("(created_by = ? OR assignee_id = ?)")
+        params.extend([user["id"], user["id"]])
+
+    return " AND ".join(clauses), params
+
+
+def _build_the_order_by_clause_string_for_task_search_sorting(q: SearchQuery) -> str:
+    """検索用 ORDER BY 句を組み立てる。"""
+    direction = "ASC" if q.order == "asc" else "DESC"
+    if q.sort == "created_at":
+        return f"created_at {direction}, id {direction}"
+    if q.sort == "due_date":
+        return f"due_date IS NULL ASC, due_date {direction}, id {direction}"
+    # priority の並び替え
+    return f"priority {direction}, id {direction}"
+
+
+def search_tasks(user: dict[str, Any], q: SearchQuery) -> dict[str, Any]:
+    """権限範囲で絞り込み・ソート・ページングして {items, total} を返す。"""
+    where, params = _build_search_where(user, q)
+    order = _build_the_order_by_clause_string_for_task_search_sorting(q)
+    offset = (q.page - 1) * q.per_page
+    conn = connect()
+    try:
+        total_row = conn.execute(
+            f"SELECT COUNT(*) AS n FROM tasks WHERE {where}", params
+        ).fetchone()
+        total = int(total_row["n"])
+        rows = conn.execute(
+            f"SELECT * FROM tasks WHERE {where} ORDER BY {order} LIMIT ? OFFSET ?",
+            [*params, q.per_page, offset],
+        ).fetchall()
+        items = [_row_to_task(conn, r) for r in rows]
+        return {"items": items, "total": total}
+    finally:
+        conn.close()
+
+
