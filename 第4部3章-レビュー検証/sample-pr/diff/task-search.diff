+"""spec-search.md テスト要件 1〜8 の網羅（JSON API 経由）。"""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+# -------- 共通ヘルパ --------
+
+
+def _create(client, **overrides):
+    payload = {"title": "t"}
+    payload.update(overrides)
+    r = client.post("/api/tasks", json=payload)
+    assert r.status_code == 201, r.text
+    return r.json()
+
+
+def _ids(items):
+    return [i["id"] for i in items]
+
+
+# -------- 1. q の部分一致 --------
+
+
+def test_search_q_partial_title_ci(client_member1):
+    a = _create(client_member1, title="Hello World")
+    b = _create(client_member1, title="Other")
+    r = client_member1.get("/api/tasks", params={"q": "hello"})
+    assert r.status_code == 200
+    ids = _ids(r.json()["items"])
+    assert a["id"] in ids
+    assert b["id"] not in ids
+
+
+def test_search_q_partial_description_ci(client_member1):
+    a = _create(client_member1, title="t1", description="A big DESCRIPTION here")
+    b = _create(client_member1, title="t2", description="nothing")
+    r = client_member1.get("/api/tasks", params={"q": "description"})
+    assert r.status_code == 200
+    ids = _ids(r.json()["items"])
+    assert a["id"] in ids
+    assert b["id"] not in ids
+
+
+# -------- 2. status 複数・priority・tag・assignee_id --------
+
+
+def test_search_status_multi(client_member1):
+    a = _create(client_member1, title="a", status="todo")
+    b = _create(client_member1, title="b", status="doing")
+    c = _create(client_member1, title="c", status="done")
+    r = client_member1.get("/api/tasks?status=todo&status=doing")
+    assert r.status_code == 200
+    ids = set(_ids(r.json()["items"]))
+    assert a["id"] in ids and b["id"] in ids
+    assert c["id"] not in ids
+
+
+def test_search_status_enum_422(client_member1):
+    r = client_member1.get("/api/tasks", params={"status": "bogus"})
+    assert r.status_code == 422
+
+
+def test_search_priority_single(client_member1):
+    a = _create(client_member1, title="a", priority="high")
+    b = _create(client_member1, title="b", priority="low")
+    r = client_member1.get("/api/tasks", params={"priority": "high"})
+    assert r.status_code == 200
+    ids = _ids(r.json()["items"])
+    assert a["id"] in ids
+    assert b["id"] not in ids
+
+
+def test_search_priority_enum_422(client_member1):
+    r = client_member1.get("/api/tasks", params={"priority": "xxx"})
+    assert r.status_code == 422
+
+
+def test_search_tag_exact(client_member1):
+    a = _create(client_member1, title="a", tags=["review"])
+    b = _create(client_member1, title="b", tags=["reviewer"])
+    r = client_member1.get("/api/tasks", params={"tag": "review"})
+    assert r.status_code == 200
+    ids = _ids(r.json()["items"])
+    assert a["id"] in ids
+    assert b["id"] not in ids
+
+
+def test_search_assignee_id_int(fresh_client_factory):
+    admin = fresh_client_factory("admin1")
+    # member1 (id=2) にアサイン
+    a = admin.post("/api/tasks", json={"title": "a", "assignee_id": 2}).json()
+    b = admin.post("/api/tasks", json={"title": "b", "assignee_id": 3}).json()
+    r = admin.get("/api/tasks", params={"assignee_id": 2})
+    assert r.status_code == 200
+    ids = _ids(r.json()["items"])
+    assert a["id"] in ids
+    assert b["id"] not in ids
+
+
+def test_search_assignee_id_non_numeric_422(client_member1):
+    r = client_member1.get("/api/tasks", params={"assignee_id": "abc"})
+    assert r.status_code == 422
+
+
+# -------- 3. due_from/due_to --------
+
+
+def test_search_due_from_to_inclusive(client_member1):
+    a = _create(client_member1, title="a", due_date="2026-06-01")
+    b = _create(client_member1, title="b", due_date="2026-06-15")
+    c = _create(client_member1, title="c", due_date="2026-06-30")
+    d = _create(client_member1, title="d", due_date="2026-05-31")
+    e = _create(client_member1, title="e", due_date="2026-07-01")
+    r = client_member1.get("/api/tasks", params={"due_from": "2026-06-01", "due_to": "2026-06-30"})
+    assert r.status_code == 200
+    ids = set(_ids(r.json()["items"]))
+    assert {a["id"], b["id"], c["id"]} <= ids
+    assert d["id"] not in ids
+    assert e["id"] not in ids
+
+
+
+
+def test_search_due_from_gt_to_422(client_member1):
+    r = client_member1.get("/api/tasks", params={"due_from": "2026-07-01", "due_to": "2026-06-30"})
+    assert r.status_code == 422
+
+
+def test_search_due_format_422(client_member1):
+    r = client_member1.get("/api/tasks", params={"due_from": "2026-13-01"})
+    assert r.status_code == 422
+
+
+# -------- 4. overdue --------
+
+
+def test_search_overdue_previous_day_included(client_member1):
+    yesterday = (date.today() - timedelta(days=1)).isoformat()
+    a = _create(client_member1, title="a", due_date=yesterday, status="todo")
+    r = client_member1.get("/api/tasks", params={"overdue": "true"})
+    assert r.status_code == 200
+    ids = _ids(r.json()["items"])
+    assert a["id"] in ids
+
+
+def test_search_overdue_today_excluded(client_member1):
+    today = date.today().isoformat()
+    a = _create(client_member1, title="a", due_date=today, status="todo")
+    r = client_member1.get("/api/tasks", params={"overdue": "true"})
+    assert r.status_code == 200
+    ids = _ids(r.json()["items"])
+    assert a["id"] not in ids
+
+
+def test_search_overdue_done_excluded(client_member1):
+    yesterday = (date.today() - timedelta(days=1)).isoformat()
+    a = _create(client_member1, title="a", due_date=yesterday, status="done")
+    r = client_member1.get("/api/tasks", params={"overdue": "true"})
+    assert r.status_code == 200
+    ids = _ids(r.json()["items"])
+    assert a["id"] not in ids
+
+
+def test_search_overdue_invalid_value_422(client_member1):
+    for val in ("false", "1", "True"):
+        r = client_member1.get("/api/tasks", params={"overdue": val})
+        assert r.status_code == 422, val
+
+
+# -------- 5. priority ソート意味順 --------
+
+
+def test_search_sort_priority_semantic_desc(client_member1):
